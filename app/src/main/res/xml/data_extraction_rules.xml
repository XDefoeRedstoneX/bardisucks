<?xml version="1.0" encoding="utf-8"?>
<!-- Nothing is backed up or transferred: the lamps' keys are bound to this device's keystore and would be
     unreadable anywhere else. Moving to a new phone means importing the devices file again. -->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="root" />
        <exclude domain="file" />
        <exclude domain="database" />
        <exclude domain="sharedpref" />
        <exclude domain="external" />
    </cloud-backup>
    <device-transfer>
        <exclude domain="root" />
        <exclude domain="file" />
        <exclude domain="database" />
        <exclude domain="sharedpref" />
        <exclude domain="external" />
    </device-transfer>
</data-extraction-rules>
